- name: Delete Index
  google.cloud.gcp_vertexai_index:
    state: absent
    display_name: "{{`{{ resource_name }}`}}"
    metadata:
      config:
        dimensions: 2
    region: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
