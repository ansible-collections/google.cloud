- name: Create feature group
  google.cloud.gcp_vertexai_feature_group:
    state: present
    name: "{{`{{ resource_name | regex_replace('-', '_') }}`}}_{{index $.Vars "suffix"}}"
    description: "My feature group"
    region: us-central1
    big_query:
      big_query_source:
        input_uri: "{{`bq://{{ gcp_project }}.{{ resource_name | regex_replace('-', '_') }}.{{ resource_name }}`}}_{{index $.Vars "suffix"}}"
    labels:
      env: ci
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfg
