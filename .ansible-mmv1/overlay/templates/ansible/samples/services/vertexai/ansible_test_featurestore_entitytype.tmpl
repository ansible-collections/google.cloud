- name: Fetch Featurestore Entitytype info
  google.cloud.gcp_vertexai_featurestore_entitytype_info:
    featurestore: "{{`{{ _myfs.name }}`}}"
    filters:
      - labels.env = "ci"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfset_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myfset.changed | bool
      - _myfset_info.resources | length >= 1
