- name: Fetch feature group info
  google.cloud.gcp_vertexai_feature_group_info:
    region: us-central1
    filters:
      - labels.env = "ci"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfg_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myfg.changed | bool
      - _myfg_info.resources | length >= 1

- name: Update feature group
  google.cloud.gcp_vertexai_feature_group:
    state: present
    name: "{{`{{ resource_name | regex_replace('-', '_') }}`}}_{{index $.Vars "suffix"}}"
    description: "Updated description"
    region: us-central1
    big_query:
      big_query_source:
        input_uri: "{{`bq://{{ gcp_project }}.{{ resource_name | regex_replace('-', '_') }}.{{ resource_name }}`}}_{{index $.Vars "suffix"}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfg

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myfg.changed | bool
