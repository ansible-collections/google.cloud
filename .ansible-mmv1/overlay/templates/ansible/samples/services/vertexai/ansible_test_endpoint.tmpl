- name: Fetch Endpoint info
  google.cloud.gcp_vertexai_endpoint_info:
    region: us-central1
    location: us-central1
    filters:
      - display_name = "{{`{{ resource_name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myep_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myep.changed | bool
      - _myep_info.resources | length >= 1
