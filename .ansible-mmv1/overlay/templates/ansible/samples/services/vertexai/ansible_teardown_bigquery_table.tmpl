- name: Delete BigQuery Table
  google.cloud.gcp_bigquery_table:
    state: absent
    name: "{{`{{ resource_name }}`}}_{{index $.Vars "suffix"}}"
    dataset: "{{`{{ resource_name | regex_replace('-', '_') }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
