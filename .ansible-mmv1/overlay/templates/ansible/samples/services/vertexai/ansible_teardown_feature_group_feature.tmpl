- name: Delete feature group feature
  google.cloud.gcp_vertexai_feature_group_feature:
    state: absent
    name: feature_a
    feature_group: "{{`{{ resource_name | regex_replace('-', '_') }}`}}_{{index $.Vars "suffix"}}"
    description: "A simple feature"
    region: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
