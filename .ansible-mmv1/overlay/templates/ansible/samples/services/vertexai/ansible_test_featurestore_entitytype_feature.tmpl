- name: Create Featurestore Entitytype Feature
  google.cloud.gcp_vertexai_featurestore_entitytype_feature:
    state: present
    name: "{{`{{ resource_name | regex_replace('-', '_') }}`}}"
    entitytype: "{{`{{ _myfset.name }}`}}"
    value_type: INT64_ARRAY
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfsetf

- name: Fetch Featurestore Entitytype Feature info
  google.cloud.gcp_vertexai_featurestore_entitytype_feature_info:
    entitytype: "{{`{{ _myfset.name }}`}}"
    filters:
      - value_type = INT64_ARRAY
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfsetf_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myfsetf.changed | bool
      - _myfsetf_info.resources | length >= 1
