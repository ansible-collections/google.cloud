- name: Fetch Index Endpoint info
  google.cloud.gcp_vertexai_index_endpoint_info:
    region: us-central1
    filters:
      - display_name = "{{`{{ resource_name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myidxep_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myidxep.changed | bool
      - _myidxep_info.resources | length >= 1

- name: Update Index Endpoint
  google.cloud.gcp_vertexai_index_endpoint:
    state: present
    display_name: "{{`{{ resource_name }}`}}"
    description: "Updated description"
    region: us-central1
    network: "{{`projects/{{ gcp_project_number }}/global/networks/{{ _network.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myidxep

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myidxep.changed | bool
      - _myidxep.description == "Updated description"
