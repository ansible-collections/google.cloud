- name: Delete Reasoning Engine
  google.cloud.gcp_vertexai_reasoning_engine:
    state: absent
    display_name: "{{`{{ resource_name }}`}}"
    region: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
