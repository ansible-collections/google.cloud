- name: Create Feature Online Store Featureview
  google.cloud.gcp_vertexai_feature_online_store_featureview:
    state: present
    name: "{{`{{ resource_name | regex_replace('-', '_') }}`}}"
    feature_online_store: "{{`{{ resource_name | regex_replace('-', '_') }}`}}_{{index $.Vars "suffix"}}"
    sync_config:
      cron: "0 0 * * *"
    big_query_source:
      uri: "bq://{{`{{ gcp_project }}`}}.{{`{{ resource_name | regex_replace('-', '_') }}`}}.{{`{{ resource_name }}`}}_{{index $.Vars "suffix"}}"
      entity_id_columns:
        - entity_id
    region: us-central1
    labels:
      env: ci
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfosf

- name: Fetch Feature Online Store Featureview info
  google.cloud.gcp_vertexai_feature_online_store_featureview_info:
    region: us-central1
    feature_online_store: "{{`{{ resource_name | regex_replace('-', '_') }}`}}_{{index $.Vars "suffix"}}"
    filters:
      - labels.env = "ci"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myfosf_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myfosf.changed | bool
      - _myfosf_info.resources | length >= 1
