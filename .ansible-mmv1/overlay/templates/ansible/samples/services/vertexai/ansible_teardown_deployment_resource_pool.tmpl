- name: Delete Deployment Resource Pool
  google.cloud.gcp_vertexai_deployment_resource_pool:
    state: absent
    name: "{{`{{ resource_name }}`}}"
    region: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
