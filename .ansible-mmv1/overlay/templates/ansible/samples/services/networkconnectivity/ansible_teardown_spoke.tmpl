- name: Delete Network Connectivity Spoke
  google.cloud.gcp_networkconnectivity_spoke:
    name: "{{`{{ resource_name }}`}}"
    state: absent
    location: global
    hub: "{{`{{ _my_hub.id }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
