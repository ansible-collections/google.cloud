- name: Create Network Connectivity Spoke
  google.cloud.gcp_networkconnectivity_spoke:
    name: my-spoke
    state: present
    description: A gateway spoke
    location: us-central1
    hub: projects/my-project/locations/us-central1/hubs/my-hub
    gateway:
      ip_range_reservations:
        - ip_range: 10.0.0.0/23
      capacity: CAPACITY_1_GBPS
    group: gateways
