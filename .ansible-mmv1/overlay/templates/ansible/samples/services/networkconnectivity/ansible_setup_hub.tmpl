- name: Create Network Connectivity Hub
  google.cloud.gcp_networkconnectivity_hub:
    name: "{{`{{ resource_name }}`}}"
    state: present
    description: My hub description
    labels:
      env: ci
    policy_mode: PRESET
    preset_topology: HYBRID_INSPECTION
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_hub
