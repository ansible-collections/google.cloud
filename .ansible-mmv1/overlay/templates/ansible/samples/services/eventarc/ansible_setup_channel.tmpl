- name: Create Eventarc Channel
  google.cloud.gcp_eventarc_channel:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mychannel
