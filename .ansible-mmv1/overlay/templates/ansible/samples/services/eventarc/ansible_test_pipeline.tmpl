- name: Fetch Eventarc Pipeline info
  google.cloud.gcp_eventarc_pipeline_info:
    location: us-central1
    filters:
      - display_name = "{{`{{ resource_name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mypipeline_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _mypipeline is changed
      - _mypipeline_info.resources | length == 1

- name: Update Eventarc Pipeline (noop)
  google.cloud.gcp_eventarc_pipeline:
    pipeline_id: "{{`{{ resource_name }}`}}"
    display_name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    destinations:
      - workflow: "{{`{{ _myworkflow.id }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mypipeline

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _mypipeline is not changed

- name: Update Eventarc Pipeline
  google.cloud.gcp_eventarc_pipeline:
    pipeline_id: "{{`{{ resource_name }}`}}"
    display_name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    destinations:
      - workflow: "{{`{{ _myworkflow.id }}`}}"
    logging_config:
      log_severity: WARNING
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mypipeline
