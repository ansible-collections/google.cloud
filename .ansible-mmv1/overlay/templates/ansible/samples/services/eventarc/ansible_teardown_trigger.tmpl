- name: Delete Eventarc Trigger
  google.cloud.gcp_eventarc_trigger:
    name: "{{`{{ resource_name }}`}}"
    state: absent
    location: us-central1
    matching_criteria: []
    destination: {}
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
