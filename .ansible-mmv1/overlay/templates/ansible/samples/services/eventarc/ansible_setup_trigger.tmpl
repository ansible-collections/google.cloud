- name: Read credential file
  ansible.builtin.slurp:
    path: "{{`{{ gcp_cred_file }}`}}"
  register: _cred_file
  when:
    - gcp_cred_kind == "serviceaccount"
    - gcp_cred_file is defined
  no_log: true

- name: Set account file fact
  ansible.builtin.set_fact:
    _account_file: "{{`{{ _cred_file.content | b64decode | from_json }}`}}"
  when:
    - gcp_cred_kind == "serviceaccount"
    - gcp_cred_file is defined
  no_log: true

- name: Create Eventarc Trigger
  google.cloud.gcp_eventarc_trigger:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    matching_criteria:
      - attribute: type
        value: google.cloud.pubsub.topic.v1.messagePublished
    destination:
      workflow: "{{`{{ _myworkflow.id }}`}}"
    service_account: "{{`{{ _account_file.client_email }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mytrigger
