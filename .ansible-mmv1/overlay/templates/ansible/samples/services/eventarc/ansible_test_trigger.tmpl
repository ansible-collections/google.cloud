- name: Fetch Eventarc Trigger info
  google.cloud.gcp_eventarc_trigger_info:
    filters:
      - name = "{{`{{ _mytrigger.id }}`}}"
    location: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mytrigger_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _mytrigger is changed
      - _mytrigger_info.resources | length == 1

- name: Update Eventarc Trigger (noop)
  google.cloud.gcp_eventarc_trigger:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    matching_criteria:
      - attribute: type
        value: google.cloud.pubsub.topic.v1.messagePublished
    destination:
      workflow: "{{`{{ _myworkflow.id }}`}}"
    service_account: "{{`{{ _account_file.client_email }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mytrigger

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _mytrigger is not changed

- name: Update Eventarc Trigger
  google.cloud.gcp_eventarc_trigger:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    matching_criteria:
      - attribute: type
        value: google.cloud.pubsub.topic.v1.messagePublished
    destination:
      workflow: "{{`{{ _myworkflow.id }}`}}"
    labels:
      env: ci
    service_account: "{{`{{ _account_file.client_email }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mytrigger

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _mytrigger is changed
      - _mytrigger.labels.env == "ci"

