- name: Create Eventarc Pipeline
  google.cloud.gcp_eventarc_pipeline:
    pipeline_id: "{{`{{ resource_name }}`}}"
    display_name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    destinations:
      - workflow: "{{`{{ _myworkflow.id }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mypipeline
