- name: Fetch project feed info
  google.cloud.gcp_cloudasset_project_feed_info:
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_project_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _my_project_feed is changed
      - _my_project_info.resources | length > 0

- name: Update Asset Project Feed (noop)
  google.cloud.gcp_cloudasset_project_feed:
    feed_id: "{{`{{ resource_name }}`}}"
    state: present
    content_type: RESOURCE
    asset_types:
      - compute.googleapis.com/Subnetwork
      - compute.googleapis.com/Network
    feed_output_config:
      pubsub_destination:
        topic: "{{`{{ _my_pubsub_topic.name }}`}}"
    project: "{{`{{ gcp_project_number }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_project_feed

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _my_project_feed is not changed

- name: Update an Asset Project Feed
  google.cloud.gcp_cloudasset_project_feed:
    feed_id: "{{`{{ resource_name }}`}}"
    state: present
    content_type: RESOURCE
    asset_types:
      - compute.googleapis.com/Subnetwork
      - compute.googleapis.com/Network
      - compute.googleapis.com/Instance
    feed_output_config:
      pubsub_destination:
        topic: "{{`{{ _my_pubsub_topic.name }}`}}"
    project: "{{`{{ gcp_project_number }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_project_feed

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _my_project_feed is changed

