- name: Create a multi-container CloudRun v2 Job
  google.cloud.gcp_cloudrunv2_job:
    name: my-job
    state: present
    location: us-central1
    template:
      template:
        containers:
          - name: job-1
            image: us-docker.pkg.dev/cloudrun/container/job
          - name: job-2
            image: us-docker.pkg.dev/cloudrun/container/job
