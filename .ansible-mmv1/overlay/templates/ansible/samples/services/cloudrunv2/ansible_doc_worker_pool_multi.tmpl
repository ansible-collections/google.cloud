- name: Create CloudRun v2 Worker Pool with multiple containers
  google.cloud.gcp_cloudrunv2_worker_pool:
    name: my-worker-pool
    state: present
    location: us-central1
    template:
      containers:
        - name: container-1
          image: us-docker.pkg.dev/cloudrun/container/worker-pool
          depends_on:
            - container-2
        - name: container-2
          image: us-docker.pkg.dev/cloudrun/container/worker-pool
