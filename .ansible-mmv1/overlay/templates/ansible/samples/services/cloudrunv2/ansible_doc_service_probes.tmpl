- name: Create a CloudRun v2 Service with probes
  google.cloud.gcp_cloudrunv2_service:
    name: my-service
    state: present
    location: us-central1
    ingress: INGRESS_TRAFFIC_ALL
    template:
      containers:
        - image: us-docker.pkg.dev/cloudrun/container/hello
          startup_probe:
            initial_delay_seconds: 0
            timeout_seconds: 1
            period_seconds: 3
            failure_threshold: 1
            tcp_socket:
              port: 8080
          liveness_probe:
            http_get:
              path: /

