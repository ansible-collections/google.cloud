- name: Destroy job
  google.cloud.gcp_cloudrunv2_job:
    name: "{{`{{ resource_name }}`}}"
    state: absent
    location: us-central1
    template:
      template:
        containers: []
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
