- name: Create a basic CloudRun v2 Worker Pool
  google.cloud.gcp_cloudrunv2_worker_pool:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    template:
      containers:
        - name: wp-1
          image: us-docker.pkg.dev/cloudrun/container/worker-pool
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _mywp
