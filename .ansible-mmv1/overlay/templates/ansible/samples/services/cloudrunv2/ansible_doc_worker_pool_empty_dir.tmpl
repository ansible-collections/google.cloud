- name: Create CloudRun v2 Worker Pool with attached volume
  google.cloud.gcp_cloudrunv2_worker_pool:
    name: my-worker-pool
    state: present
    location: us-central1
    template:
      containers:
        - name: container-1
          image: us-docker.pkg.dev/cloudrun/container/worker-pool
          volume_mounts:
            - name: empty-dir-vol
              mount_path: /mnt
      volumes:
        - name: empty-dir-vol
          empty_dir:
            medium: MEMORY
            size_limit: 256Mi
