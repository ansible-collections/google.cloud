- name: Fetch job info
  google.cloud.gcp_cloudrunv2_job_info:
    location: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myjob_info

# list endpoint doesn't support filtering, do it client-side
- name: Filter by job name
  ansible.builtin.set_fact:
    _myjob_fact: "{{`{{ item }}`}}"
  loop: "{{`{{ _myjob_info.resources | selectattr('name', 'equalto', _myjob.name) }}`}}"

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myjob is changed
      - _myjob_info.resources | length > 0
      - _myjob_fact is defined

- name: Update job to add volume
  google.cloud.gcp_cloudrunv2_job:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    template:
      template:
        volumes:
          - name: empty-dir-vol
            empty_dir:
              medium: MEMORY
              size_limit: 128Mi
        containers:
          - name: job-1
            image: us-docker.pkg.dev/cloudrun/container/job
            volume_mounts:
              - name: empty-dir-vol
                mount_path: /mnt
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myjob

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myjob is changed
      - _myjob.template.template.volumes | length == 1

- name: Add a second container to job
  google.cloud.gcp_cloudrunv2_job:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    template:
      template:
        volumes:
          - name: empty-dir-vol
            empty_dir:
              medium: MEMORY
              size_limit: 128Mi
        containers:
          - name: job-1
            image: us-docker.pkg.dev/cloudrun/container/job
            volume_mounts:
              - name: empty-dir-vol
                mount_path: /mnt
          - name: job-2
            image: us-docker.pkg.dev/cloudrun/container/job
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myjob

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myjob is changed
      - _myjob.template.template.containers | length == 2
