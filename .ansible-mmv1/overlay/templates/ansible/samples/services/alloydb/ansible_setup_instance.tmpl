- name: Create alloydb instance
  google.cloud.gcp_alloydb_instance:
    instance_id: "{{`{{ resource_name }}`}}"
    state: present
    instance_type: PRIMARY
    cluster: "{{`{{ _primary }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _instance
