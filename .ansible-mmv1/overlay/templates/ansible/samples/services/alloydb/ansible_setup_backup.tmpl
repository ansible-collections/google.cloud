- name: Create a backup for cluster
  google.cloud.gcp_alloydb_backup:
    backup_id: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    cluster_name: "{{`{{ _primary.name }}`}}"
    type: ON_DEMAND
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _backup
