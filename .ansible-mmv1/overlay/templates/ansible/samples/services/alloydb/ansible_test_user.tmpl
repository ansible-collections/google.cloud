- name: Fetch user info
  google.cloud.gcp_alloydb_user_info:
    cluster: "{{`{{ _primary.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _user_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _user.changed | bool
      - _user_info.resources | length >= 1
