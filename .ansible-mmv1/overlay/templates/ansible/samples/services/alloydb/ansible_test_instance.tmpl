- name: Fetch instance info
  google.cloud.gcp_alloydb_instance_info:
    cluster: "{{`{{ _primary.name }}`}}"
    filters:
      - name = "{{`{{ _instance.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _instance_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _instance.changed | bool
      - _instance_info.resources | length >= 1
