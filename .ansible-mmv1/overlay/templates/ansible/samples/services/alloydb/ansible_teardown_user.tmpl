- name: Delete user
  google.cloud.gcp_alloydb_user:
    user_id: okuser
    state: absent
    user_type: ALLOYDB_BUILT_IN
    password: "good-user-{{`{{ resource_name }}`}}"
    database_roles:
      - alloydbsuperuser
    cluster: "{{`{{ _primary }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
