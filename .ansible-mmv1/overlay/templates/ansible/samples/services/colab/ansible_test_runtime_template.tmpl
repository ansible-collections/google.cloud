- name: Fetch runtime template info
  google.cloud.gcp_colab_runtime_template_info:
    location: us-central1
    filters:
      - display_name = "{{`{{ resource_name }}`}}-{{index $.Vars "suffix"}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myrtt_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myrtt.changed | bool
      - _myrtt_info.resources | length >= 1
