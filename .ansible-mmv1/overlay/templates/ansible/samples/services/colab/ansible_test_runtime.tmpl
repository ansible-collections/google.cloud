- name: Create Runtime in RUNNING (default) State
  google.cloud.gcp_colab_runtime:
    state: present
    name: "{{`{{ resource_name }}`}}-up"
    display_name: "{{`{{ resource_name }}`}}-rt"
    runtime_user: "{{`{{ gcp_integration_email }}`}}"
    location: us-central1
    auto_upgrade: true
    notebook_runtime_template_ref:
      notebook_runtime_template: "{{`{{ _myrtt.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myrt

- name: Fetch runtime info
  google.cloud.gcp_colab_runtime_info:
    location: us-central1
    filters:
      - display_name = "{{`{{ resource_name }}`}}-rt"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myrt_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myrt.changed | bool
      - _myrt.runtimeState == "RUNNING"
      - _myrt_info.resources | length >= 1

- name: Update Runtime State to STOPPED
  google.cloud.gcp_colab_runtime:
    state: present
    name: "{{`{{ resource_name }}`}}-up"
    display_name: "{{`{{ resource_name }}`}}-up"
    runtime_user: "{{`{{ gcp_integration_email }}`}}"
    location: us-central1
    desired_state: STOPPED
    notebook_runtime_template_ref:
      notebook_runtime_template: "{{`{{ _myrtt.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myrt

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myrt.changed | bool
      - _myrt.runtimeState == "STOPPED"

- name: Create Runtime in STOPPED State
  google.cloud.gcp_colab_runtime:
    state: present
    name: "{{`{{ resource_name }}`}}-dn"
    display_name: "{{`{{ resource_name }}`}}-dn"
    runtime_user: "{{`{{ gcp_integration_email }}`}}"
    location: us-central1
    desired_state: STOPPED
    auto_upgrade: true
    notebook_runtime_template_ref:
      notebook_runtime_template: "{{`{{ _myrtt.name }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _myrt

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myrt.changed | bool
      - _myrt.runtimeState == "STOPPED"
