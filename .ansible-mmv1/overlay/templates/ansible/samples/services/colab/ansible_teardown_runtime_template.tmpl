- name: Delete Runtime Template
  google.cloud.gcp_colab_runtime_template:
    name: "{{`{{ resource_name }}`}}-{{index $.Vars "suffix"}}"
    state: absent
    display_name: "{{`{{ resource_name }}`}}-{{index $.Vars "suffix"}}"
    location: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
