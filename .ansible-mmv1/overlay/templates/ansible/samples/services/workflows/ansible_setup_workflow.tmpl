- name: Create Workflow
  google.cloud.gcp_workflows_workflow:
    name: "{{`{{ resource_name }}`}}"
    state: present
    region: us-central1
    description: My test workflow
    call_log_level: LOG_ERRORS_ONLY
    source_contents: |
      main:
        steps:
          - assignStep:
              assign:
                - sum: 0
          - loopStep:
              for:
                value: v
                range: [1, 9]
                steps:
                  - sumStep:
                      assign:
                        - sum: ${sum + v}
          - returnStep:
              return: ${sum}
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myworkflow
