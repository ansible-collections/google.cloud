- name: Fetch Workflow info
  google.cloud.gcp_workflows_workflow_info:
    filters:
      - name = "{{`{{ _myworkflow.id }}`}}"
    region: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myworkflow_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myworkflow is changed
      - _myworkflow_info.resources | length > 0

- name: Update Workflow (noop)
  google.cloud.gcp_workflows_workflow:
    name: "{{`{{ resource_name }}`}}"
    state: present
    region: us-central1
    description: My test workflow
    call_log_level: LOG_ERRORS_ONLY
    source_contents: |
      main:
        steps:
          - assignStep:
              assign:
                - sum: 0
          - loopStep:
              for:
                value: v
                range: [1, 9]
                steps:
                  - sumStep:
                      assign:
                        - sum: ${sum + v}
          - returnStep:
              return: ${sum}
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myworkflow

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myworkflow is not changed

- name: Update Workflow
  google.cloud.gcp_workflows_workflow:
    name: "{{`{{ resource_name }}`}}"
    state: present
    region: us-central1
    description: My test workflow
    call_log_level: LOG_ERRORS_ONLY
    source_contents: |
      main:
        steps:
          - assignStep:
              assign:
                - sum: 0
          - loopStep:
              for:
                value: v
                range: [1, 19]
                steps:
                  - sumStep:
                      assign:
                        - sum: ${sum + v}
          - returnStep:
              return: ${sum}
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _myworkflow

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _myworkflow is changed
