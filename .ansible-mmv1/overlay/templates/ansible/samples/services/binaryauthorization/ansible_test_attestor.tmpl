- name: Fetch Attestor Info
  google.cloud.gcp_binaryauthorization_attestor_info:
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_attestor_info

- name: Run Assertions
  ansible.builtin.assert:
    that:
      - _my_attestor.changed | bool
      - _my_attestor_info.resources | length >= 1

- name: Update Attestor
  google.cloud.gcp_binaryauthorization_attestor:
    name: "{{`{{ resource_name }}`}}"
    state: present
    attestation_authority_note:
      note_reference: "{{`{{ _mynote.id }}`}}"
    description: "My test attestor (updated)"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_attestor

- name: Run Assertions
  ansible.builtin.assert:
    that:
      - _my_attestor.changed | bool
      - _my_attestor.description == "My test attestor (updated)"

