- name: Create Custom Policy
  google.cloud.gcp_binaryauthorization_policy:
    state: present
    admission_whitelist_patterns:
      - name_pattern: "gcr.io/google_containers/*"
    default_admission_rule:
      evaluation_mode: ALWAYS_ALLOW
      enforcement_mode: ENFORCED_BLOCK_AND_AUDIT_LOG
    cluster_admission_rules:  # enforce attestations in a given cluster
      - cluster: us-central1-a.my-cluster
        evaluation_mode: REQUIRE_ATTESTATION
        enforcement_mode: ENFORCED_BLOCK_AND_AUDIT_LOG
        require_attestations_by:
          - projects/my-project/attestor/attestor-1
          - projects/my-project/attestor/attestor-2
