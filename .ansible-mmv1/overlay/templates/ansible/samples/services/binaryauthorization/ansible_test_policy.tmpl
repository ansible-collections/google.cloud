- name: Fetch Custom Policy Info
  google.cloud.gcp_binaryauthorization_policy_info:
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file | default(omit) }}`}}"
  register: _my_policy_info

- name: Run assertions
  ansible.builtin.assert:
    that:
      - _my_policy.changed | bool
      - _my_policy_info.resources | length >= 1
