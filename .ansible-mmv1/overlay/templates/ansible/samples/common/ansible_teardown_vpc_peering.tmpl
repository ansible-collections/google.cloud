- name: Delete peering range
  google.cloud.gcp_compute_global_address:
    name: "{{`{{ resource_name }}`}}-peering"
    state: absent
    address_type: INTERNAL
    prefix_length: 16
    purpose: VPC_PEERING
    network: "{{`{{ _network }}`}}"
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
