- name: Create storage bucket
  google.cloud.gcp_storage_bucket:
    name: "{{`{{ resource_name }}`}}"
    state: present
    location: us-central1
    project: "{{`{{ gcp_project }}`}}"
    auth_kind: "{{`{{ gcp_cred_kind }}`}}"
    service_account_file: "{{`{{ gcp_cred_file }}`}}"
  register: _mybucket
